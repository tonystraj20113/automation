-- Generated by src/roblox_place.py. Do not edit the @@PLAN@@ line by hand.
-- Runs headless in Roblox Studio:
--   RobloxStudioBeta.exe --task RunScript --runScriptFile build_place.luau \
--     --outputFile studio.log --quitAfterExecution
-- The file exports the real .rbxl place and prints SCENE_JSON:<json> so the
-- cloud renderer can reproduce the same blocky world without a GUI.
local HttpService = game:GetService("HttpService")
local PLAN = HttpService:JSONDecode([[@@PLAN@@]])
local ws = workspace

-- Start from an empty baseplate so the output is reproducible.
for _, child in ipairs(ws:GetChildren()) do
	if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Folder") then
		child:Destroy()
	end
end

local function vec(t) return Vector3.new(t[1], t[2], t[3]) end
local function rgb(t) return Color3.fromRGB(t[1], t[2], t[3]) end

local function makePart(d)
	local p = Instance.new("Part")
	p.Name = d.n or "Part"
	p.Shape = d.sh == "Ball" and Enum.PartType.Ball
		or (d.sh == "Cylinder" and Enum.PartType.Cylinder or Enum.PartType.Block)
	p.Size = vec(d.s)
	p.CFrame = CFrame.new(vec(d.p)) * CFrame.Angles(d.r[1], d.r[2], d.r[3])
	p.Color = rgb(d.c)
	p.Anchored = true
	p:SetAttribute("g", d.g or 0)
	p:SetAttribute("role", d.role or "set")
	p.Parent = ws
	return p
end

for _, d in ipairs(PLAN.parts) do
	makePart(d)
end

-- Serialise every part with its world transform. The renderer uses the same
-- matrices, so what is built in Studio is exactly what appears on screen.
local parts = {}
for _, p in ipairs(ws:GetDescendants()) do
	if p:IsA("BasePart") then
		local cf, rx, ry, rz = p.CFrame, p.CFrame:ToEulerAnglesXYZ()
		local shape = "Box"
		if p:IsA("Part") then
			if p.Shape == Enum.PartType.Ball then shape = "Ball"
			elseif p.Shape == Enum.PartType.Cylinder then shape = "Cylinder" end
		end
		table.insert(parts, {
			n = p.Name,
			sh = shape,
			s = { p.Size.X, p.Size.Y, p.Size.Z },
			p = { cf.Position.X, cf.Position.Y, cf.Position.Z },
			r = { rx, ry, rz },
			c = { math.floor(p.Color.R * 255 + 0.5), math.floor(p.Color.G * 255 + 0.5), math.floor(p.Color.B * 255 + 0.5) },
			g = p:GetAttribute("g") or 0,
			role = p:GetAttribute("role") or "set",
		})
	end
end

local scene = { parts = parts, groups = PLAN.groups, title = PLAN.title }
print("SCENE_JSON:" .. HttpService:JSONEncode(scene))

-- Save the editable Roblox place into the repository output folder.
local okPM, PM = pcall(function() return game:GetService("PluginManager") end)
if okPM and PLAN.placePath ~= "" then
	pcall(function() PM:ExportPlace(PLAN.placePath) end)
end
print("DONE")
